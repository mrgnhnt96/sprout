# pubspec.lock IS committed: docs/research/05-dart-stack.md takeaway 8 makes
# "the build resolves" a check, which requires the lockfile in the tree.
.dart_tool/
build/

# `.revali/` is NOT ignored, as of P4-01.
#
# Generated by `dart run revali build` and never hand-edited — but committed,
# because `bin/sprout.dart` imports `.revali/server/server.dart` to be the
# daemon as well as the CLI, and three test files import `bin/sprout.dart`. A
# tree without it would not analyze and its tests would not compile, so a clean
# checkout has to carry it. Same trade as `lib/src/ui/assets.g.dart` (P3-03).
#
# It costs little to keep honest: 501 lines over seven files, no absolute or
# machine-specific paths, and `revali build` re-emits it byte for byte. Run
# `dart run revali build` after touching `routes/` and commit the diff.

# Build-time-only Jaspr payload rsync'd in from sprout_ui at CI time.
web/
